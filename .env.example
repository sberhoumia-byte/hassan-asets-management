# انسخ هذا الملف إلى .env واملأ القيم. لا تضع قيماً حقيقية في المستودع.
NODE_ENV=development
DATABASE_URL=postgresql://hassan:CHANGE_ME@localhost:5432/hassan_assets?schema=public
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=CHANGE_ME_long_random_value
JWT_REFRESH_SECRET=CHANGE_ME_another_long_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
STORAGE_DRIVER=local
STORAGE_PATH=./storage
UPLOAD_MAX_MB=20
BACKUP_PATH=./backups
