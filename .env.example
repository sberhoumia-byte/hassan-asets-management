# انسخ هذا الملف إلى .env واملأ القيم. لا تضع قيماً حقيقية في المستودع.
# توليد سر عشوائي: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development

# قاعدة البيانات
POSTGRES_USER=hassan
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hassan_assets
DATABASE_URL=postgresql://hassan:CHANGE_ME@localhost:5432/hassan_assets?schema=public
# قاعدة منفصلة لاختبارات التكامل (لا تجعلها نفس قاعدة التطوير)
TEST_DATABASE_URL=postgresql://hassan:CHANGE_ME@localhost:5432/hassan_test?schema=public

# الخادم
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_random_chars
JWT_REFRESH_SECRET=CHANGE_ME_another_32_random_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
STORAGE_PATH=./storage
# اختياري: إن وُضع، يجب إدخاله في شاشة الإعداد الأول (يحمي خادماً مكشوفاً قبل إنشاء المدير)
SETUP_TOKEN=
# true مع HTTPS (الافتراضي في الإنتاج)، false على شبكة محلية عبر http
COOKIE_SECURE=
# محاولات الدخول لكل عنوان في الدقيقة
LOGIN_RATE_LIMIT=10

# Docker
WEB_PORT=8080
