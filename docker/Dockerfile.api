# خادم API (NestJS) + أدوات الهجرة. يُبنى من جذر المستودع: docker build -f docker/Dockerfile.api .
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/ packages/
COPY database/package.json database/
RUN npm ci --workspaces --include-workspace-root --ignore-scripts && npm rebuild argon2
COPY database/ database/
COPY apps/api/ apps/api/
RUN npm run generate -w @hassan/database && npm run build -w @hassan/api

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
# محرك PDF (المرحلة 7): Chromium من توزيعة Debian. الخطوط مضمنة في كل وثيقة (حزم @fontsource) فلا حاجة لخطوط النظام.
# داخل الحاوية يعمل Chromium دون sandbox (مستخدم غير root، JavaScript معطل، لا شبكة، مصادر data: فقط).
# النسخ الاحتياطي (المرحلة 9): pg_dump/pg_restore بنفس إصدار الخادم (16) من مستودع PostgreSQL الرسمي، وtar.
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates curl gnupg \
  && install -d /usr/share/postgresql-common/pgdg \
  && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
  && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update && apt-get install -y --no-install-recommends postgresql-client-16 \
  && apt-get purge -y curl gnupg && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
ENV CHROMIUM_PATH=/usr/bin/chromium PDF_NO_SANDBOX=true
COPY --from=build /app /app
RUN mkdir -p /data/storage /data/backups && chown -R node:node /data
USER node
EXPOSE 3000
# عند كل تشغيل: تطبيق الهجرات الجديدة (غير هدّام) + بيانات الأساس (idempotent، لا تنشئ مستخدمين) ثم الخادم
CMD ["sh", "-c", "cd /app/database && npx prisma migrate deploy && npx tsx seeds/seed.ts && cd /app/apps/api && node dist/main.js"]
