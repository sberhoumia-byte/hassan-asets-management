{
  "name": "hassan-assets-management",
  "version": "0.3.0",
  "private": true,
  "description": "HASSAN IBN THABIT – ASSETS MANAGEMENT SYSTEM | نظام التدبير المادي",
  "workspaces": [
    "apps/*",
    "packages/*",
    "database"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:validate": "npm run validate -w @hassan/database",
    "db:generate": "npm run generate -w @hassan/database",
    "db:migrate": "npm run migrate:dev -w @hassan/database",
    "dev:web": "npm run dev -w @hassan/web",
    "dev:api": "npm run dev -w @hassan/api",
    "build:web": "npm run build -w @hassan/web",
    "build:android": "echo \"[المرحلة 10] أمر البناء لم يُربط بعد\" && exit 1",
    "build:windows": "echo \"[المرحلة 10] أمر البناء لم يُربط بعد\" && exit 1",
    "test": "npm test -w @hassan/web && npm test -w @hassan/api",
    "build:review": "npm run build:review -w @hassan/web",
    "test:e2e": "npm run test:e2e -w @hassan/web",
    "typecheck": "npm run typecheck -w @hassan/web && npm run typecheck -w @hassan/api",
    "db:seed": "npm run seed -w @hassan/database",
    "db:deploy": "npm run migrate:deploy -w @hassan/database",
    "build:api": "npm run build -w @hassan/api",
    "test:api": "npm test -w @hassan/api",
    "test:e2e:server": "npm run test:e2e:server -w @hassan/web"
  }
}
